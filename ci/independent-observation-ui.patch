diff --git a/src/features/review/ConsumerObservationReviewPanel.tsx b/src/features/review/ConsumerObservationReviewPanel.tsx
new file mode 100644
index 0000000..31aed05
--- /dev/null
+++ b/src/features/review/ConsumerObservationReviewPanel.tsx
@@ -0,0 +1,157 @@
+'use client';
+
+import { useState } from 'react';
+import { useWorkspace } from '@/features/workspace/WorkspaceProvider';
+import type { Project } from '@/domain/schema';
+import type { ConsumerReview } from '@/domain/consumer-review-schema';
+import { addConsumerReview, consumerReviewReasons, reviewConsumerObservation, revalidateConsumerReviews } from '@/domain/consumer-review';
+
+const kindNames: Record<ConsumerReview['kind'], string> = {
+  satisfaction: '만족', preference: '선호', alternative_use: '대체 사용',
+  barrier: '장애', followup: '후속 경과',
+};
+const statusNames: Record<ConsumerReview['status'], string> = {
+  review_required: '의미 검토 대기', accepted: '검토 수용', held: '검토 보류',
+  rejected: '검토 거절', stale: '근거 변경으로 무효',
+};
+const actorNames: Record<ConsumerReview['history'][number]['actor'], string> = {
+  human: '화면 검토 입력(신원 미인증)', test: '허구 시험 입력', integrity_check: '자동 무결성 검사',
+};
+
+/** Human-authored observation review only. Does not change question, insight or content paths. */
+export function ConsumerObservationReviewPanel({ project, update }: { project: Project; update: (next: Project) => void }) {
+  const { flush, saveState, error: saveError } = useWorkspace();
+  const [pending, setPending] = useState(false);
+  const [rowId, setRowId] = useState('');
+  const [kind, setKind] = useState<ConsumerReview['kind']>('satisfaction');
+  const [quote, setQuote] = useState('');
+  const [reportedContent, setReportedContent] = useState('');
+  const [interpretation, setInterpretation] = useState('');
+  const [limitations, setLimitations] = useState('');
+  const [decisionReasons, setDecisionReasons] = useState<Record<string, string>>({});
+  const [confirmed, setConfirmed] = useState<Record<string, boolean>>({});
+  const [error, setError] = useState('');
+  const [notice, setNotice] = useState('');
+
+  const rows = project.consumerObservations.filter(row => row.projectId === project.id &&
+    row.importStatus === 'accepted' && !!row.evidenceLink &&
+    project.sources.some(s => s.id === row.evidenceLink?.sourceId && s.projectId === project.id));
+  const chosen = rows.find(row => row.id === rowId);
+  const chosenSource = project.sources.find(s => s.id === chosen?.evidenceLink?.sourceId);
+  const reviews = project.consumerObservationReviews;
+
+  const act = async (action: () => Project, success: string): Promise<boolean> => {
+    if (pending || saveState === 'error') return false;
+    setPending(true);
+    try { update(revalidateConsumerReviews(action())); await flush(); setError(''); setNotice(success); return true; }
+    catch (cause) { setError(cause instanceof Error ? cause.message : '소비자 관찰을 저장하지 못했습니다.'); setNotice(''); return false; }
+    finally { setPending(false); }
+  };
+  const create = async () => {
+    if (await act(() => addConsumerReview(project, { kind, reportedContent: reportedContent.trim(),
+      interpretation: interpretation.trim(), limitations: limitations.trim(), evidence: [{ rowId, quote }] }, 'human'),
+    '독립 소비자 관찰을 검토 대기 상태로 저장했습니다. 의미 승인이나 실제 소비자 수요의 확정이 아닙니다.')) {
+      setQuote(''); setReportedContent(''); setInterpretation(''); setLimitations('');
+    }
+  };
+  const decide = async (id: string, status: 'accepted' | 'held' | 'rejected') => {
+    if (project.consumerObservationReviews.find(r => r.id === id)?.history.some(h => h.actor === 'test')) { setError('시험 이력이 있는 기록은 보존하고 새 관찰을 작성해 주세요.'); return; }
+    if (!confirmed[id]) { setError('원문·해석·시점·표본 한계를 직접 대조했는지 확인해 주세요.'); setNotice(''); return; }
+    if (await act(() => reviewConsumerObservation(project, id, status, decisionReasons[id] || '', 'human'),
+      `검토 상태를 ${statusNames[status]}(으)로 기록했습니다. 외부 AI·전략·작성 경로로 자동 전달하지 않습니다.`)) {
+      setConfirmed(current => ({ ...current, [id]: false }));
+      setDecisionReasons(current => ({ ...current, [id]: '' }));
+    }
+  };
+
+  return <section className="card" aria-labelledby="consumer-observation-review-heading">
+    <details>
+      <summary id="consumer-observation-review-heading">독립 소비자 관찰 검토 ({reviews.length}건)</summary>
+      <p className="small muted">질문이 없는 만족·선호·대체 사용·장애·후속 경과를 원문 근거와 별도로 기록합니다.
+        실제 소비자 발언, 검토자의 해석, 제품의 검증된 사실은 서로 다릅니다. 여러 발언이 같은 사건이면 독립 수요로 계산하지 않습니다.</p>
+      <p className="small muted">출처·원문 행은 위 ‘소비자 원문에서 질문 발견’ 영역에서 먼저 연결합니다.
+        검토 기록은 이 브라우저에서 사람이 입력한 것으로 표시하지만, 신원 인증이나 독립적인 사람의 의미 승인 증명은 아닙니다.
+        외부 AI 전송과 글 작성에는 이 기록을 사용하지 않습니다.</p>
+      {saveError && <p role="alert" className="alert">저장 오류: {saveError}</p>}
+      {pending && <p role="status">검토 기록을 저장하고 있습니다…</p>}
+      {error && <p role="alert" className="alert">{error}</p>}
+      {notice && <p role="status" className="small">{notice}</p>}
+      <fieldset>
+        <legend>새 소비자 관찰 작성 (검토 대기)</legend>
+        <label className="field">근거가 되는 소비자 원문 행
+          <select value={rowId} onChange={event => { setRowId(event.target.value); setQuote(''); }}>
+            <option value="">원문 행을 선택해 주세요</option>
+            {rows.map(row => <option key={row.id} value={row.id}>행 {row.sourceRow}: {(row.text || row.query || '').slice(0,90)}</option>)}
+          </select>
+        </label>
+        {chosen && <div className="small"><p><strong>현재 원문</strong> · {chosenSource?.title || '출처 없음'}</p>
+          <blockquote>{chosen.text || chosen.query}</blockquote>
+          <p className="muted">사건 ID: {chosen.evidenceLink?.incidentId} · 게시 시점: {chosenSource?.publishedAt || '미기재'}</p>
+          <p className="muted">현재 출처의 외부 AI 제공: {chosenSource?.externalAiAllowed ? '별도 권한 기록 있음' : '허용되지 않음'}. 이 화면의 로컬 검토는 외부 전송이 아닙니다.</p>
+        </div>}
+        {!rows.length && <p className="small muted">검토 가능한 원문 행이 없습니다. 출처와 원문을 먼저 연결해 주세요.</p>}
+        <label className="field">관찰 종류
+          <select value={kind} onChange={event => setKind(event.target.value as ConsumerReview['kind'])}>
+            {(Object.keys(kindNames) as ConsumerReview['kind'][]).map(value =>
+              <option key={value} value={value}>{kindNames[value]}</option>)}
+          </select>
+        </label>
