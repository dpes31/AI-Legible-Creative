+          <textarea value={quote} onChange={event => setQuote(event.target.value)} placeholder="원문에서 연속된 표현을 그대로 붙여넣으세요. 중복 위치가 있으면 저장되지 않습니다." />
+        </label>
+        <label className="field">소비자가 보고한 내용 (사실 확정 아님)
+          <textarea value={reportedContent} onChange={event => setReportedContent(event.target.value)} placeholder="예: 소비자는 교환 이후 동일한 증상이 재발했다고 보고함" />
+        </label>
+        <label className="field">검토자의 해석 (선택)
