@@ -0,0 +1,145 @@
+import { test, expect, type Page, type Locator } from '@playwright/test';
+import { readFileSync } from 'node:fs';
+import type { Project } from '../src/domain/schema';
+
+// SYNTHETIC ONLY: no real consumer records, AI calls or production approvals.
+const utterance = '😀 허구 제품의 형태가 마음에 듭니다. 이후 장애가 재발했습니다.';
+const excerpt = '허구 제품의 형태가 마음에 듭니다.';
+const reason = '허구 원문과 후속 경과의 표현을 직접 대조했습니다. 일반화하지 않습니다.';
+
+async function setup(page: Page) {
+  await page.goto('/');
+  await page.getByLabel('무엇을 알리고 싶으신가요?').fill('허구 독립 관찰 UI 검증');
+  await page.getByRole('button', { name: '브랜드 분석 시작' }).click();
+  const discovery = page.locator('section').filter({ has: page.getByRole('heading', { name: '소비자 원문에서 질문 발견', exact: true }) });
+  await discovery.getByText('공개 소비자 발췌와 출처 연결', { exact: true }).click();
+  await discovery.getByLabel('발췌 자료명').fill('허구 선호·후속 경과');
+  await discovery.getByLabel('소비자 원문 URL').fill('https://example.test/synthetic-review/one');
+  await discovery.getByLabel('소비자 원문 발췌').fill(utterance);
+  await discovery.getByLabel('확보 구간·생략 범위').fill('허구 시험을 위해 작성된 원문 전체');
+  await discovery.getByRole('button', { name: '발췌·관찰 행 저장' }).click();
+  await expect(discovery.getByRole('status')).toContainText('소비자 행과 원문 스냅샷');
+  const panel = page.locator('section').filter({ has: page.locator('#consumer-observation-review-heading') });
+  await panel.locator('summary#consumer-observation-review-heading').click();
+  await panel.getByLabel('근거가 되는 소비자 원문 행').selectOption({ index: 1 });
+  await panel.getByLabel('원문 속 정확한 인용문 (그대로 복사)').fill(excerpt);
+  await panel.getByLabel('소비자가 보고한 내용 (사실 확정 아님)').fill('허구 소비자가 형태 선호를 언급했다는 보고');
+  await panel.getByLabel('검토자의 해석 (선택)').fill('선호 표현이 모든 사용자의 평가를 대표하지 않습니다.');
+  await panel.getByLabel('표본·시점·대안 해석의 한계 (필수)').fill('허구 단일 사건의 발언입니다. 대표성과 현재 상태는 모릅니다.');
+  await panel.getByRole('button', { name: '관찰 초안 저장 (의미 검토 대기)' }).click();
+  await expect(panel.getByRole('status')).toContainText('검토 대기 상태로 저장');
+  return panel;
+}
+
+async function backup(page: Page): Promise<Project> {
+  await expect(page.getByRole('status').filter({ hasText: '이 브라우저에 저장됨' })).toBeVisible();
+  await page.goto('/settings');
+  const event = page.waitForEvent('download');
+  await page.getByRole('button', { name: '현재 작업 백업 받기', exact: true }).click();
+  return JSON.parse(readFileSync((await (await event).path())!, 'utf8'));
+}
+
+async function decide(panel: Locator, status: '수용' | '보류' | '거절') {
+  const article = panel.locator('article.card').last();
+  const details = article.locator('details').filter({ hasText: '사람 의미 검토 (수용·보류·거절)' });
+  if (!(await details.evaluate(element => (element as HTMLDetailsElement).open))) await details.locator('summary').click();
+  await article.getByLabel('원문·사건·후속 경과·대안 해석·표본 한계를 화면에서 직접 확인했습니다.').check();
+  await article.getByLabel('검토 판단 이유 (10자 이상)').fill(reason);
+  await article.getByRole('button', { name: `검토 ${status}` }).click();
+  await expect(panel.getByRole('status')).toContainText(`검토 ${status}`);
+}
+
+test('허구 독립 관찰: 정확 인용·UTF-16 위치·사건 ID를 화면에서 확인한다', async ({ page }) => {
+  const panel = await setup(page);
+  await expect(panel.locator('article.card')).toHaveCount(1);
+  await expect(panel.locator('article.card')).toContainText('UTF-16 [3, 22)');
+  const p = await backup(page);
+  expect(p.consumerObservationReviews).toHaveLength(1);
+  expect(p.consumerObservationReviews[0].status).toBe('review_required');
+  const evidence = p.consumerObservationReviews[0].evidence[0];
+  expect(utterance.slice(evidence.start, evidence.end)).toBe(excerpt);
+  expect(p.questions).toHaveLength(0);
+});
+
+test('허구 독립 관찰: 화면 검토 수용과 재열기를 구분한다', async ({ page }) => {
+  const panel = await setup(page);
+  await decide(panel, '수용');
+  const before = await backup(page);
+  await page.goto('/review');
+  await page.reload();
+  await page.locator('#consumer-observation-review-heading').click();
+  await expect(page.locator('article.card').last()).toContainText('검토 수용');
+  const p = await backup(page);
+  expect(p.consumerObservationReviews[0].history.at(-1)?.actor).toBe('human');
+  expect(p.consumerObservationReviews[0].status).toBe('accepted');
+  expect(p.questionCandidates).toHaveLength(0);
+  expect(p.consumerObservationReviews).toEqual(before.consumerObservationReviews);
+  expect(p.questionDiscoveryRuns).toEqual(before.questionDiscoveryRuns);
+  expect(p.researchInsights).toEqual(before.researchInsights);
+});
+
+test('허구 독립 관찰: 검토 보류와 거절을 독립적으로 보존한다', async ({ page }) => {
+  const panel = await setup(page);
+  await decide(panel, '보류');
+  await decide(panel, '거절');
+  const p = await backup(page);
+  expect(p.consumerObservationReviews[0].status).toBe('rejected');
+  expect(p.consumerObservationReviews[0].history.map(h => h.status)).toEqual(['review_required', 'held', 'rejected']);
+});
+
+test('허구 독립 관찰: 출처 변경은 이전 수용을 무효화하고 이력을 보존한다', async ({ page, browser }) => {
+  const panel = await setup(page);
+  await decide(panel, '수용');
+  const stored = await backup(page);
+  stored.sources[0].externalAiAllowed = true; // synthetic backup only; no request is sent
+  const context = await browser.newContext({ baseURL: test.info().project.use.baseURL });
+  try {
+    const reopened = await context.newPage();
+    await reopened.goto('/settings');
+    await reopened.getByLabel('이전에 받은 새 버전 백업 가져오기').setInputFiles({
+      name: 'synthetic-changed.json', mimeType: 'application/json', buffer: Buffer.from(JSON.stringify(stored)),
+    });
+    await expect(reopened.getByText('백업을 새 작업으로 가져왔습니다.', { exact: false })).toBeVisible();
+    await reopened.goto('/review');
+    await reopened.locator('#consumer-observation-review-heading').click();
+    await expect(reopened.locator('article.card').last()).toContainText('근거 변경으로 무효');
+    const modified = await backup(reopened);
+    const record = modified.consumerObservationReviews[0];
+    expect(record.status).toBe('stale');
+    expect(record.history.at(-1)?.actor).toBe('integrity_check');
+    expect(record.history.some(h => h.status === 'accepted')).toBe(true);
+  } finally { await context.close(); }
+});
+
+test('허구 독립 관찰: 시험 actor는 사람 승인으로 표시하지 않는다', async ({ page, browser }) => {
+  const panel = await setup(page);
+  await decide(panel, '수용');
+  const stored = await backup(page);
+  stored.consumerObservationReviews[0].history[1].actor = 'test';
+  const context = await browser.newContext({ baseURL: test.info().project.use.baseURL });
+  try {
+    const reopened = await context.newPage();
+    await reopened.goto('/settings');
+    await reopened.getByLabel('이전에 받은 새 버전 백업 가져오기').setInputFiles({
+      name: 'synthetic-test-actor.json', mimeType: 'application/json', buffer: Buffer.from(JSON.stringify(stored)),
+    });
+    await expect(reopened.getByText('백업을 새 작업으로 가져왔습니다.', { exact: false })).toBeVisible();
+    await reopened.goto('/review');
+    await reopened.locator('#consumer-observation-review-heading').click();
+    await expect(reopened.getByText('허구 시험 기록 포함', { exact: false })).toBeVisible();
+    await reopened.locator('article.card').last().getByText('검토 이력 및 무효화 이유', { exact: false }).click();
+    await expect(reopened.getByText('허구 시험 입력', { exact: false })).toBeVisible();
+  } finally { await context.close(); }
+});
+
+test('허구 독립 관찰: UI에서 외부 AI 제공 권한을 요구하지 않는다', async ({ page }) => {
+  const panel = await setup(page);
+  const p = await backup(page);
+  expect(p.sources[0].externalAiAllowed).toBe(false);
+  expect(p.consumerObservationReviews[0].status).toBe('review_required');
+  expect(p.questionDiscoveryRuns).toHaveLength(0);
+  expect(p.observations).toHaveLength(0);
+  await page.goto('/review');
+  await page.locator('#consumer-observation-review-heading').click();
+  await expect(panel).toContainText('외부 AI 제공: 허용되지 않음');
+});
