+        <label className="field">표본·시점·대안 해석의 한계 (필수)
+          <textarea value={limitations} onChange={event => setLimitations(event.target.value)} placeholder="예: 동일 사건의 후속 발언이며 현재 미충족 여부는 확인되지 않음" />
+        </label>
+        <button type="button" className="button secondary" onClick={create} disabled={pending || saveState === 'error' || !rowId || !quote.trim() || !reportedContent.trim() || !limitations.trim()}>
+          관찰 초안 저장 (의미 검토 대기)
+        </button>
+      </fieldset>
+      <h3>보관된 관찰과 의미 검토 이력</h3>
+      {!reviews.length && <p className="small muted">아직 작성한 관찰이 없습니다.</p>}
+      {reviews.map(record => {
+        const issues = consumerReviewReasons(project, record);
+        const testOnly = record.history.some(h => h.actor === 'test');
+        const otherInIncident = reviews.filter(r => r.incidentId === record.incidentId).length;
+        return <article key={record.id} className="card">
+          <h4>{kindNames[record.kind]} · {statusNames[record.status]}</h4>
+          {testOnly && <p className="small"><strong>허구 시험 기록 포함 — 실제 사람의 의미 승인으로 집계 금지</strong></p>}
+          <p className="small">소비자 보고: {record.reportedContent}</p>
+          <p className="small">검토자 해석: {record.interpretation || '별도 해석 없음'}</p>
+          <p className="small">한계: {record.limitations}</p>
+          <p className="small muted">사건 ID: {record.incidentId} · 게시 시점: {record.utteredAt || '미기재'} · 같은 사건의 관찰 기록 {otherInIncident}건 (독립 소비자 수 아님)</p>
+          {record.evidence.map((e, i) => <div key={`${e.rowId}-${e.start}-${e.end}-${i}`}>
+            <blockquote>{e.quote}</blockquote>
+            <p className="small muted">원문 행 {e.rowId} · 출처 {e.sourceId} · UTF-16 [{e.start}, {e.end}) · 스냅샷 {e.snapshotId}</p>
+          </div>)}
+          {issues.length > 0 && <div role="alert">{issues.map(reason => <p key={reason} className="small">무결성 확인 필요: {reason}</p>)}</div>}
+          {record.status === 'stale' && <p className="small">기존 검토를 되살리지 않습니다. 현재 근거로 새 관찰 기록을 작성해 주세요.</p>}
+          {record.status !== 'stale' && !testOnly && <details><summary>사람 의미 검토 (수용·보류·거절)</summary>
+            <label className="row small"><input type="checkbox" checked={confirmed[record.id] || false}
+              onChange={event => setConfirmed(old => ({ ...old, [record.id]: event.target.checked }))} />
+              원문·사건·후속 경과·대안 해석·표본 한계를 화면에서 직접 확인했습니다.</label>
+            <label className="field">검토 판단 이유 (10자 이상)
+              <textarea value={decisionReasons[record.id] || ''} onChange={event => setDecisionReasons(old => ({ ...old, [record.id]: event.target.value }))} />
+            </label>
+            <div className="row">
+              <button type="button" className="button secondary" onClick={() => decide(record.id, 'accepted')} disabled={pending || saveState === 'error' || issues.length > 0}>검토 수용</button>
+              <button type="button" className="button secondary" disabled={pending || saveState === 'error'} onClick={() => decide(record.id, 'held')}>검토 보류</button>
+              <button type="button" className="button secondary" disabled={pending || saveState === 'error'} onClick={() => decide(record.id, 'rejected')}>검토 거절</button>
+            </div>
+          </details>}
+          <details><summary>검토 이력 및 무효화 이유 ({record.history.length}건)</summary>
+            {record.history.map((history, i) => <p className="small" key={`${history.at}-${i}`}>
+              {history.at} · {statusNames[history.status]} · {actorNames[history.actor]} · {history.reason}
+            </p>)}
+            <p className="small muted">마지막 판단: {record.reason}</p>
+          </details>
+        </article>;
+      })}
+    </details>
+  </section>;
+}
